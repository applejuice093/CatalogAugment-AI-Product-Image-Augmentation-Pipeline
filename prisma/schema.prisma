datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  assets        Asset[]
  products      Product[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Asset {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  originalName        String
  relativePath        String
  mime                String
  bytes               Int
  width               Int?
  height              Int?
  format              String?
  maskPath            String?
  foregroundPath      String?
  segmentationModel   String?
  segmentationVersion String?
  segmentationStatus  String?  @default("PENDING")
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@map("asset")
}

model Product {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sku         String?  @unique
  category    String?
  subcategory String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images      Asset[]
  jobs        AugmentationJob[]
  vlmAnalyses VLMAnalysis[]
  datasetItems DatasetItem[]

  @@index([userId])
  @@map("product")
}

model AugmentationJob {
  id              String               @id @default(uuid())
  productId       String
  product         Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String?
  inputAssetId    String?
  promptId        String?
  status          String               @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, CANCELLED
  workflowId      String
  workflowVersion String
  configJson      Json?
  progress        Int                  @default(0)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  results         AugmentationResult[]

  @@index([productId])
  @@index([userId])
  @@map("augmentation_job")
}

model AugmentationResult {
  id              String           @id @default(uuid())
  jobId           String?
  job             AugmentationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  productId       String
  originalAssetId String?
  imagePath       String
  thumbnailPath   String?
  comfyFilename   String?
  prompt          String?
  negativePrompt  String?
  seed            BigInt?
  cfg             Float?
  steps           Int?
  denoise         Float?
  sampler         String?
  workflowId          String
  workflowVersion     String
  isComposited        Boolean          @default(true)
  compositionStrategy String?          @default("alpha_feathered")
  status              String           @default("COMPLETED")
  reviewDecision      String           @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_REVIEW
  reviewNotes         String?
  reviewedAt          DateTime?
  reviewedBy          String?
  createdAt           DateTime         @default(now())

  vlmAnalyses         VLMAnalysis[]
  qualityAssessment   QualityAssessment?
  datasetItems        DatasetItem[]

  @@index([jobId])
  @@index([productId])
  @@map("augmentation_result")
}

model QualityAssessment {
  id                         String             @id @default(uuid())
  augmentationResultId       String             @unique
  augmentationResult         AugmentationResult @relation(fields: [augmentationResultId], references: [id], onDelete: Cascade)
  productId                  String
  foregroundPreservationScore Float
  perceptualSimilarityScore   Float
  sharpnessScore             Float
  exposureScore              Float
  vlmConsistencyScore        Float?
  compositeScore             Float
  decision                   String             // "PASS", "REJECT", "NEEDS_REVIEW"
  signals                    Json               // Detailed signal breakdown
  reviewerId                 String?
  reviewedAt                 DateTime?
  reviewNotes                String?
  rejectionReason            String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([productId])
  @@index([decision])
  @@map("quality_assessment")
}

model VLMAnalysis {
  id                   String              @id @default(uuid())
  productId            String
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  augmentationResultId String?
  augmentationResult   AugmentationResult? @relation(fields: [augmentationResultId], references: [id], onDelete: SetNull)
  taskType             String              // "PRODUCT_ANALYSIS", "IMAGE_CONSISTENCY", "METADATA_ENRICHMENT"
  provider             String              // "ollama", "cloud", "mock"
  modelName            String
  promptVersion        String              @default("1.0.0")
  rawOutput            String?
  normalizedData       Json
  isConsistent         Boolean?
  confidence           Float?
  latencyMs            Int?
  createdAt            DateTime            @default(now())

  @@index([productId])
  @@index([augmentationResultId])
  @@map("vlm_analysis")
}

model Workflow {
  id          String   @id
  name        String
  version     String
  description String?
  inputSchema Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("workflow")
}

model Dataset {
  id            String        @id @default(uuid())
  userId        String
  name          String
  version       String        @default("1.0.0")
  description   String?
  splitConfig   Json          // { train: 0.70, val: 0.15, test: 0.15, seed: 42 }
  totalProducts Int           @default(0)
  totalImages   Int           @default(0)
  status        String        @default("READY") // "READY", "EXPORTING", "ARCHIVED"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         DatasetItem[]

  @@index([userId])
  @@map("dataset")
}

model DatasetItem {
  id                   String              @id @default(uuid())
  datasetId            String
  dataset              Dataset             @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  productId            String
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                  String
  split                String              // "train", "val", "test"
  augmentationResultId String?
  augmentationResult   AugmentationResult? @relation(fields: [augmentationResultId], references: [id], onDelete: SetNull)
  imagePath            String
  isOriginal           Boolean             @default(false)
  metadata             Json?               // Full lineage & provenance snapshot
  createdAt            DateTime            @default(now())

  @@index([datasetId])
  @@index([split])
  @@index([productId])
  @@map("dataset_item")
}
